# ---------------------------------------------------------------------------
# Configuración a NIVEL DE SERVIDOR (igual para todo el equipo)
# Copia estas variables en Easypanel -> tu servicio -> Environment.
# ---------------------------------------------------------------------------

# URL de tu instancia de Odoo Online (sin barra final)
ODOO_URL=https://tuempresa.odoo.com

# Nombre de la base de datos de Odoo (en Odoo Online suele coincidir con el subdominio)
ODOO_DB=tuempresa

# Modo de autenticación:
#   per_user  -> (RECOMENDADO) cada usuario DEBE enviar sus cabeceras X-Odoo-Login / X-Odoo-Api-Key
#   fallback  -> si un usuario no envía cabeceras, se usan las credenciales de respaldo de abajo
ODOO_AUTH_MODE=per_user

# Credenciales de respaldo OPCIONALES (solo se usan si ODOO_AUTH_MODE=fallback).
# Déjalas vacías en un despliegue de equipo para forzar identidad individual.
ODOO_FALLBACK_LOGIN=
ODOO_FALLBACK_API_KEY=

# Puerto interno del contenedor (Easypanel lo mapea automáticamente).
PORT=8000
HOST=0.0.0.0
