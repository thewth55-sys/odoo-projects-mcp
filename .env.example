# ---------------------------------------------------------------------------
# Configuración a NIVEL DE SERVIDOR (igual para todo el equipo)
# Copia estas variables en Easypanel -> tu servicio -> Environment.
# ---------------------------------------------------------------------------

# URL de tu instancia de Odoo Online (sin barra final)
ODOO_URL=https://tuempresa.odoo.com

# Nombre de la base de datos de Odoo (en Odoo Online suele coincidir con el subdominio)
ODOO_DB=tuempresa

# ---------------------------------------------------------------------------
# USUARIOS: mapa token -> login + API key personal de Odoo
# ---------------------------------------------------------------------------
# Cada persona recibe una URL propia:  https://<dominio>/mcp/<token>
# El token identifica al usuario; su API key vive SOLO aquí (nunca en la URL).
#
# Formato: una línea por usuario -> token|login|api_key
# Genera tokens aleatorios con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(12))"
#
# Ejemplo (reemplaza por tus valores reales):
ODOO_USERS=2NkgNSerM5dtSWId|oswaldo@zuhma.online|TU_API_KEY_DE_ODOO
# Para varios usuarios, añade más líneas dentro de la MISMA variable:
# ODOO_USERS=2NkgNSerM5dtSWId|oswaldo@zuhma.online|API_KEY_OSWALDO
# 9qe2N4Ubcm24qEPH|maria@zuhma.online|API_KEY_MARIA
# up9_KWJm6P1X_Jm4|juan@zuhma.online|API_KEY_JUAN

# ---------------------------------------------------------------------------
# AUTO-REGISTRO (opción self-service): los usuarios se dan de alta solos en /enroll
# ---------------------------------------------------------------------------
# Con esto NO tienes que editar ODOO_USERS ni redesplegar por cada persona.
# ODOO_USERS de arriba queda OPCIONAL (útil solo para sembrar al admin inicial).

# Clave de invitación: quien la tenga puede auto-registrarse en /enroll.
# Si la dejas vacía, /enroll queda deshabilitado. Genera una robusta, p. ej.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ENROLL_SECRET=cambia-esta-clave-de-invitacion

# Archivo donde se guardan los usuarios auto-registrados. DEBE estar en un
# VOLUMEN PERSISTENTE de Easypanel (monta /data) para que sobreviva a redeploys.
ODOO_USERS_FILE=/data/users.json

# URL pública base para construir el enlace personal que se muestra tras el registro.
# Recomendado fijarla para que el enlace salga siempre correcto.
PUBLIC_BASE_URL=https://odoo-mcp.tudominio.com

# ---------------------------------------------------------------------------
# SEGURIDAD / HARDENING
# ---------------------------------------------------------------------------

# Cifrado en reposo del archivo de usuarios (MUY recomendado).
# Genera la clave con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guárdala fuera del repo. Si la pierdes, los usuarios deberán re-registrarse.
MASTER_KEY=

# Caducidad de los enlaces auto-registrados, en días (0 = sin caducidad).
# Con esto los tokens rotan periódicamente: al caducar, el usuario se re-registra.
TOKEN_TTL_DAYS=0

# Rate limiting "N/segundos" por IP.
ENROLL_RATELIMIT=5/60
MCP_RATELIMIT=240/60

# Borrado permanente vía MCP. Por defecto DESHABILITADO (recomendado).
# Ponlo en true solo si realmente necesitas borrar proyectos/tareas desde Claude.
ALLOW_DELETE=false

# Path del endpoint MCP (por defecto /mcp). Normalmente no hace falta cambiarlo.
MCP_PATH=/mcp

# Puerto interno del contenedor (Easypanel lo mapea automáticamente).
PORT=8000
HOST=0.0.0.0
